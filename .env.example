# Copy to .env and fill in. Never commit .env — every .env* except this file is git-ignored.
# Anything the deployed app needs must also be set in Vercel > Environment Variables.

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC_. Bypasses row-level security, so it is only
# used for signing private KYC document URLs and bot uploads with no user session.
SUPABASE_SECRET_KEY=

# Supabase Postgres — dashboard > Connect > ORMs > Prisma
# DATABASE_URL is the pooler (port 6543), DIRECT_URL is direct (port 5432) for migrations.
DATABASE_URL=
DIRECT_URL=

# Meta Cloud API — App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-paste-the-same-one-into-meta
WHATSAPP_GRAPH_VERSION=v21.0

# Anthropic — used for service-offering extraction
ANTHROPIC_API_KEY=

# Where the bot posts completed profiles.
PROFILE_API_URL=http://localhost:3000/api/mock-registry/providers
PROFILE_API_TOKEN=

PORT=3000

# Hackathon-only: skips real OTP/KYC verification (see core/constants/auth.constant.ts,
# isMockAuthEnabled). Leave unset in production.
ALLOW_MOCK_AUTH=

# Hackathon-only: outside production, bypasses page-auth redirects in middleware.ts
# (isDemoBypassEnabled), so any page URL opens directly without a session. API guards still 401.
# Its own flag — does NOT imply ALLOW_MOCK_AUTH. The pitch run sets both, plus NEXT_PUBLIC_DEMO_MODE
# below. Leave unset in production.
ALLOW_DEMO_BYPASS=

# Hackathon pitch mode only — set alongside ALLOW_MOCK_AUTH=true to drive the host happy path with
# no typing, recording or camera. Does not affect the server-side redirect bypass, which is its own
# flag (ALLOW_DEMO_BYPASS above). Leave unset in production.
NEXT_PUBLIC_DEMO_MODE=
