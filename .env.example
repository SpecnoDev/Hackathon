# Copy to .env and fill in. Never commit .env — every .env* except this file is git-ignored.
# Anything the deployed app needs must also be set in Vercel > Environment Variables.

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC_. Bypasses row-level security, so it is only
# used for signing private KYC document URLs and bot uploads with no user session.
SUPABASE_SECRET_KEY=

# Supabase Postgres — dashboard > Connect > ORMs > Prisma
# DATABASE_URL is the pooler (port 6543), DIRECT_URL is direct (port 5432) for migrations.
DATABASE_URL=
DIRECT_URL=

# Meta Cloud API — App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-paste-the-same-one-into-meta
WHATSAPP_GRAPH_VERSION=v21.0

# Anthropic — used for service-offering extraction
ANTHROPIC_API_KEY=

# Resend — sends the traveller sign-in code and link. Supabase only mints them; its own sender
# is rate limited to a few emails an hour. RESEND_FROM defaults to no-reply@hosted.com and must be
# on a domain verified in Resend; if Resend refuses it, the app retries once through Resend's test
# sender, which only delivers to your own address.
RESEND_API_KEY=
RESEND_FROM=no-reply@hosted.com

# The public origin the app is served from. Sign-in links and invite links are built from it,
# so in Vercel it must be the production URL, never a branch alias.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the bot posts completed profiles.
PROFILE_API_URL=http://localhost:3000/api/mock-registry/providers
PROFILE_API_TOKEN=

PORT=3000

# Hackathon demo switch. "true" opens /admin without a sign-in, lets the host OTP mock through,
# and puts "Continue as Jess" buttons on /login. Never set in production.
ALLOW_MOCK_AUTH=

# Hackathon-only: outside production, bypasses page-auth redirects in middleware.ts
# (isDemoBypassEnabled), so any page URL opens directly without a session. API guards still 401.
# Its own flag — does NOT imply ALLOW_MOCK_AUTH. The pitch run sets both this and ALLOW_MOCK_AUTH,
# plus the Demo mode toggle in /admin (below). Leave unset in production.
ALLOW_DEMO_BYPASS=

# Pitch mode (the prefilled host flow) is no longer a variable: switch it on and off per browser from
# the back office sidebar (Demo mode). It still needs ALLOW_MOCK_AUTH=true for the OTP step, and
# ALLOW_DEMO_BYPASS=true above for the deep-link redirect bypass.
