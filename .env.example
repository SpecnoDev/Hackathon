# Meta Cloud API — App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-paste-the-same-one-into-meta
WHATSAPP_GRAPH_VERSION=v21.0

# Anthropic — used for service-offering extraction
ANTHROPIC_API_KEY=

# Destination API for completed profiles.
# Defaults to this app's own stub endpoint so the flow is demoable today.
PROFILE_API_URL=http://localhost:3000/mock-registry/providers
PROFILE_API_TOKEN=

PORT=3000
